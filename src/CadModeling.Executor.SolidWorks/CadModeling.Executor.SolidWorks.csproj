<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1127.0.0</Version>
    <InformationalVersion>1127</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SolidWorksInteropDir Condition="'$(SolidWorksInteropDir)' == ''">$(ProgramW6432)\SOLIDWORKS Corp\SOLIDWORKS</SolidWorksInteropDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CadModeling.Core\CadModeling.Core.csproj" />
    <ProjectReference Include="..\CadModeling.Ir\CadModeling.Ir.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(SolidWorksInteropDir)\SolidWorks.Interop.sldworks.dll')">
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- The SP matters: the high-precision ray API first shipped in 2018 SP2. -->
  <Target Name="SelectSolidWorksApi" BeforeTargets="CoreCompile">
    <GetAssemblyIdentity AssemblyFiles="$(SolidWorksInteropDir)\SolidWorks.Interop.sldworks.dll">
      <Output TaskParameter="Assemblies" ItemName="_SwAssembly" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <_SwVersion>@(_SwAssembly->'%(Version)')</_SwVersion>
      <DefineConstants Condition="$([MSBuild]::VersionLessThan('$(_SwVersion)', '26.2'))">$(DefineConstants);SW_BEFORE_HIGH_PRECISION_RAYS</DefineConstants>
      <DefineConstants Condition="$([MSBuild]::VersionLessThan('$(_SwVersion)', '27.0'))">$(DefineConstants);SW_BEFORE_CONCENTRIC_DEFINITION</DefineConstants>
      <DefineConstants Condition="$([MSBuild]::VersionLessThan('$(_SwVersion)', '28.0'))">$(DefineConstants);SW_BEFORE_2020</DefineConstants>
    </PropertyGroup>
  </Target>
</Project>
